  "components": {
    "schemas": {
      "Body_analyze_image_analyze_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "H&E Histopathology image (PNG, JPG, BMP, TIF)"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id",
            "description": "Optional Case Identifier"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_analyze_image_analyze_post"
      },
      "CaseResultResponse": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "image_quality": {
            "additionalProperties": true,
            "type": "object",
            "title": "Image Quality"
          },
          "digepath": {
            "additionalProperties": true,
            "type": "object",
            "title": "Digepath"
          },
          "prediction": {
            "additionalProperties": true,
            "type": "object",
            "title": "Prediction"
          },
          "uncertainty": {
            "additionalProperties": true,
            "type": "object",
            "title": "Uncertainty"
          },
          "model_agreement": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model Agreement"
          },
          "nuclear_evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Nuclear Evidence"
          },
          "gland_evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Gland Evidence"
          },
          "reference_comparison": {
            "additionalProperties": true,
            "type": "object",
            "title": "Reference Comparison"
          },
          "priority_regions": {
            "items": {
              "$ref": "#/components/schemas/RegionDetailSchema"
            },
            "type": "array",
            "title": "Priority Regions"
          },
          "visualizations": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Visualizations"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "explanation": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "timestamp",
          "status",
          "image_quality",
          "digepath",
          "prediction",
          "uncertainty",
          "model_agreement",
          "nuclear_evidence",
          "gland_evidence",
          "reference_comparison",
          "priority_regions"
        ],
        "title": "CaseResultResponse"
      },
      "CaseSummaryItem": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "prediction_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prediction Class"
          },
          "confidence": {
            "anyOf": [
